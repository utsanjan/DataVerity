{
  "name": "playjs",
  "version": "1.0.0",
  "description": "Playwright UI and Databricks data-validation automation for Promo Pulse, Wealth Pulse, and Governance.",
  "scripts": {
    "test": "playwright test",
    "test:promo-pulse": "playwright test",
    "test:headed": "playwright test --headed",
    "test:list": "playwright test --list",
    "test:validation:list": "playwright test --config=playwright.validation.config.js --list",
    "test:wealth-pulse": "npm run wealth-pulse-validate",
    "test:wealth-pulse-ui": "playwright test --config=playwright.validation.config.js tests/wealth-pulse/leadership-kpi-validation-ui.spec.js",
    "test:wealth-pulse-databricks": "playwright test --config=playwright.validation.config.js tests/wealth-pulse/leadership-kpi-databricks-ui.spec.js",
    "test:wealth-pulse-databricks-api": "playwright test --config=playwright.validation.config.js tests/wealth-pulse/leadership-kpi-databricks-api.spec.js",
    "wealth-pulse-compare": "node src/wealth-pulse/reporters/leadership-kpi-compare.js",
    "wealth-pulse-leadership-validate": "npm run test:wealth-pulse-ui && npm run test:wealth-pulse-databricks && npm run wealth-pulse-compare",
    "test:wealth-pulse-advisor-ui": "playwright test --config=playwright.validation.config.js tests/wealth-pulse/advisor-kpi-validation-ui.spec.js",
    "test:wealth-pulse-advisor-databricks": "playwright test --config=playwright.validation.config.js tests/wealth-pulse/advisor-kpi-databricks-ui.spec.js",
    "wealth-pulse-advisor-compare": "node src/wealth-pulse/reporters/advisor-kpi-compare.js",
    "wealth-pulse-advisor-validate": "npm run test:wealth-pulse-advisor-ui && npm run test:wealth-pulse-advisor-databricks && npm run wealth-pulse-advisor-compare",
    "wealth-pulse-compare-all": "node src/wealth-pulse/reporters/wealth-pulse-combined-compare.js",
    "wealth-pulse-validate": "npm run wealth-pulse-leadership-validate && npm run wealth-pulse-advisor-validate && npm run wealth-pulse-compare-all",
    "test:governance-ui": "playwright test --config=playwright.validation.config.js tests/governance/governance-kpi-ui.spec.js",
    "test:governance-databricks": "playwright test --config=playwright.validation.config.js tests/governance/governance-kpi-databricks.spec.js",
    "test:governance-notebooks": "playwright test --config=playwright.validation.config.js tests/governance/governance-notebook-recommendations.spec.js",
    "governance-compare": "node src/governance/reporters/governance-kpi-compare.js",
    "governance-validate": "npm run test:governance-ui && npm run test:governance-databricks && npm run test:governance-notebooks && npm run governance-compare",
    "master-report": "node src/reporters/master-validation-report.js",
    "reports:build": "npm run governance-compare && npm run wealth-pulse-compare-all && npm run master-report",
    "databricks:export": "node --max-old-space-size=8192 scripts/export-databricks-tables.js",
    "test:report": "playwright show-report artifacts/reports/playwright",
    "clean:generated": "node scripts/clean-generated-artifacts.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@databricks/sql": "^2.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
